STORYVIDEOGEN_DOMAIN=podcast.example.com
ACME_EMAIL=admin@example.com

STORYVIDEOGEN_NODE_HOST=0.0.0.0
STORYVIDEOGEN_NODE_PORT=3000
STORYVIDEOGEN_NODE_LOG_LEVEL=info
STORYVIDEOGEN_DATABASE_PATH=/app/output/storyvideogen.sqlite3
STORYVIDEOGEN_STORAGE_ROOT=/app/output/assets
STORYVIDEOGEN_WORKER_ROOT=/app/output/worker
STORYVIDEOGEN_MIGRATIONS_DIR=/app/server/migrations
STORYVIDEOGEN_WEB_ROOT=/app/web/dist
STORYVIDEOGEN_PYTHON=/usr/local/bin/python3.12
STORYVIDEOGEN_SECURE_COOKIES=true
STORYVIDEOGEN_SECRET_MASTER_KEY=replace-with-base64-encoded-32-byte-key
STORYVIDEOGEN_SECRET_KEY_ID=v1
STORYVIDEOGEN_PROVIDER_TEST_MODE=live
STORYVIDEOGEN_PAYMENT_MODE=disabled
STORYVIDEOGEN_WORKER_FIXTURE_MODE=false
STORYVIDEOGEN_WORKER_POLL_MS=500
STORYVIDEOGEN_WORKER_LEASE_SECONDS=30
STORYVIDEOGEN_WORKER_TIMEOUT_SECONDS=3600
STORYVIDEOGEN_WORKER_SILENCE_SECONDS=720
STORYVIDEOGEN_MAX_UPLOAD_BYTES=10485760
STORYVIDEOGEN_AUTH_ATTEMPT_LIMIT=10
STORYVIDEOGEN_ZHIPU_TEXT_MODEL=glm-5.2
STORYVIDEOGEN_ZHIPU_IMAGE_MODEL=cogview-3-flash
