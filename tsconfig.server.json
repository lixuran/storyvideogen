{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "server/src",
    "outDir": "server/dist",
    "sourceMap": true,
    "declaration": true,
    "types": ["node"]
  },
  "include": ["server/src/**/*.ts"]
}
